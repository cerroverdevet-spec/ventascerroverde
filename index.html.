function totalQ(){return Object.values(cart).reduce((a,b)=>a+b,0)}
function badges(){const n=totalQ();document.querySelectorAll('[data-badge]').forEach(b=>{b.textContent=n;b.hidden=n===0});$('fab').hidden=n===0;}
function add(id,d=1){cart[id]=(cart[id]||0)+d;if(cart[id]<=0)delete cart[id];save();badges();render();drawCart();}
const cdl=$('carro');
function drawCart(){
  const ids=Object.keys(cart);
  $('items').innerHTML=ids.length?ids.map(id=>{const p=D.find(x=>x.id===id);return `<div class="it"><div class="im">${p.img?`<img src="${p.img}" alt="">`:''}</div><div><b>${esc(p.n)}</b><span>${esc(p.s)}</span><br><button type="button" class="rm" data-rm="${id}">Quitar</button></div><div class="qty"><button type="button" data-q="${id}" data-d="-1" aria-label="Quitar uno">−</button><output>${cart[id]}</output><button type="button" data-q="${id}" data-d="1" aria-label="Agregar uno">+</button></div></div>`}).join(''):'<div class="cempty">Tu carrito está vacío. Agrega equipos desde el catálogo.</div>';
  $('c-send').hidden=!ids.length;$('c-clr').hidden=!ids.length;cupd();
}
function cupd(){
  const v=id=>$(id).value.trim();
  let t='Hola Cerro Verde, quiero hacer este pedido:';
  Object.keys(cart).forEach(id=>{const p=D.find(x=>x.id===id);t+='\n• '+cart[id]+' × '+p.n+' ('+p.s+')'});
  if(v('c-name'))t+='\nNombre: '+v('c-name');
  if(v('c-clinic'))t+='\nClínica: '+v('c-clinic');
  if(v('c-city'))t+='\nEnvío a: '+v('c-city');
  if(v('c-msg'))t+='\nComentarios: '+v('c-msg');
  $('c-send').href=wa(t);
}
$('cform').addEventListener('input',cupd);$('cform').addEventListener('submit',e=>e.preventDefault());
$('items').addEventListener('click',e=>{const q=e.target.closest('[data-q]');if(q)add(q.dataset.q,+q.dataset.d);const r=e.target.closest('[data-rm]');if(r){delete cart[r.dataset.rm];save();badges();render();drawCart();}});
$('c-clr').addEventListener('click',()=>{cart={};save();badges();render();drawCart();});
$('c-x').addEventListener('click',()=>cdl.close());
cdl.addEventListener('click',e=>{if(e.target===cdl)cdl.close();});
document.querySelectorAll('[data-cart]').forEach(b=>b.addEventListener('click',()=>{drawCart();if(typeof cdl.showModal==='function')cdl.showModal();else cdl.setAttribute('open','');}));
document.addEventListener('click',e=>{const a=e.target.closest('[data-add]');if(!a)return;e.stopPropagation();add(a.dataset.add);if(a.dataset.fx)openF(a.dataset.add);},true);
grid.addEventListener('click',e=>{if(e.target.closest('a,[data-add]'))return;const c=e.target.closest('[data-id]');if(c)openF(c.dataset.id);});
dlg.addEventListener('click',e=>{if(e.target===dlg)dlg.close();});
render();badges();

const sel=$('q-prod');
sel.innerHTML='<option>Varios equipos / no estoy seguro</option>'+LINES.map(c=>`<optgroup label="${c}">`+D.filter(p=>p.c===c).map(p=>`<option>${esc(p.n)} — ${esc(p.s)}</option>`).join('')+'</optgroup>').join('');
const f=$('quote'),send=$('q-send');
function upd(){
  const v=id=>$(id).value.trim();
  let t='Hola Cerro Verde, quiero una cotización.';
  if(v('q-name'))t+='\nNombre: '+v('q-name');
  if(v('q-clinic'))t+='\nClínica: '+v('q-clinic');
  if(v('q-city'))t+='\nCiudad / estado: '+v('q-city');
  t+='\nEquipo: '+sel.value;
  if(v('q-msg'))t+='\nDetalles: '+v('q-msg');
  send.href=wa(t);
}
f.addEventListener('input',upd);f.addEventListener('change',upd);f.addEventListener('submit',e=>e.preventDefault());upd();
document.querySelectorAll('[data-copy]').forEach(b=>b.addEventListener('click',()=>{
  const t=b.dataset.copy,done=()=>{b.textContent='Copiado';setTimeout(()=>b.textContent='Copiar',1600)};
  const s=()=>{const v=b.parentElement.querySelector('.v');const r=document.createRange();r.selectNodeContents(v);const g=getSelection();g.removeAllRanges();g.addRange(r)};
  try{navigator.clipboard.writeText(t).then(done,s)}catch(e){s()}
}));
</script>

