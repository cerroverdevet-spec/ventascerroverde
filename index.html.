const LINES=["Imagenología","Laboratorio","Odontología","Quirófano y anestesia","Esterilización","Oftalmología","Hospitalización"];
const $=id=>document.getElementById(id);
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const wa=t=>'https://wa.me/584226425278?text='+encodeURIComponent(t);
const norm=s=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
D.forEach(p=>p.k=norm([p.n,p.s,p.c,p.d,p.t].join(' ')));
document.querySelectorAll('[data-cnt]').forEach(e=>{const n=D.filter(p=>p.c===e.dataset.cnt).length;e.textContent=n+(n===1?' equipo':' equipos')});
let cart={};
try{cart=JSON.parse(localStorage.getItem('cv-carrito')||'{}')||{}}catch(e){cart={}}
for(const k in cart){if(!D.some(p=>p.id===k)||!(cart[k]>0))delete cart[k]}
const save=()=>{try{localStorage.setItem('cv-carrito',JSON.stringify(cart))}catch(e){}};
let cur='Todos';
const grid=$('grid'),fl=$('filters'),q=$('q');
fl.innerHTML=['Todos',...LINES].map(c=>`<button type="button" data-c="${c}" aria-pressed="false">${c}</button>`).join('');
function render(){
  const t=norm(q.value.trim()).split(/\s+/).filter(Boolean);
  const list=D.filter(p=>(cur==='Todos'||p.c===cur)&&t.every(w=>p.k.includes(w)));
  grid.innerHTML=list.map(p=>`<article class="prod" data-id="${p.id}"><div class="ph">${p.img?`<img src="${p.img}" alt="${esc(p.n)}, ${esc(p.s)}" loading="lazy">`:`<span class="noimg">Imagen del producto</span>`}</div><div class="bd"><div class="cat">${esc(p.c)}</div><h3>${esc(p.n)}</h3><div class="nm">${esc(p.s)}</div><div class="sp">${p.st.slice(0,3).map(s=>esc(s.v)+' '+esc(s.l)).join(' · ')}</div><div class="acts"><button type="button" class="add${cart[p.id]?' in':''}" data-add="${p.id}">${cart[p.id]?'En el carrito ('+cart[p.id]+')':'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>Agregar'}</button><span class="links"><button type="button" class="open" data-id="${p.id}">Ver ficha</button></span></div></div></article>`).join('');
  $('count').textContent=list.length+(list.length===1?' equipo':' equipos');
  $('empty').hidden=list.length>0;
  fl.querySelectorAll('button').forEach(b=>b.setAttribute('aria-pressed',b.dataset.c===cur));
}
fl.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;cur=b.dataset.c;render();});
q.addEventListener('input',render);
document.querySelectorAll('[data-go]').forEach(b=>b.addEventListener('click',()=>{cur=b.dataset.go;q.value='';render();$('equipos').scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});}));
function specs(p){
  let h='',kv=[];
  const flush=()=>{if(kv.length){h+='<table class="kv">'+kv.map(([k,v])=>`<tr><th>${esc(k)}</th><td>${esc(v)}</td></tr>`).join('')+'</table>';kv=[]}};
  p.sp.forEach(s=>{if(s.k!==undefined)kv.push([s.k,s.v]);else if(s.head){flush();h+='<div class="tw"><table class="mt"><thead><tr>'+s.head.map(x=>`<th>${esc(x)}</th>`).join('')+'</tr></thead><tbody>'+s.rows.map(r=>'<tr>'+r.map(c=>`<td>${esc(c)}</td>`).join('')+'</tr>').join('')+'</tbody></table></div>'}});
  flush();return h;
}
const dlg=$('ficha');
function openF(id){
  const p=D.find(x=>x.id===id);if(!p)return;
  $('fx').innerHTML=`<div class="side"><div class="pic">${p.img?`<img src="${p.img}" alt="${esc(p.n)}">`:'<span class="noimg">Imagen del producto</span>'}</div><div><div class="cat">${esc(p.c)}</div><h3 id="f-n">${esc(p.n)}</h3><div class="sb">${esc(p.s)}</div></div><div class="stats">${p.st.map(s=>`<div class="st"><b>${esc(s.v)}</b><span>${esc(s.l)}</span></div>`).join('')}</div><button type="button" class="btn btn-light" data-add="${p.id}" data-fx="1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2.5 3h2.6l2.3 11.2a2 2 0 0 0 2 1.6h8.3a2 2 0 0 0 1.9-1.5L21.5 7H6"/></svg>${cart[p.id]?'En el carrito ('+cart[p.id]+') · agregar otro':'Agregar al carrito'}</button></div><div class="main"><button type="button" class="close" id="f-x">Cerrar</button><p class="desc">${esc(p.d)}</p><h4>Características</h4><div class="feats">${p.f.map(f=>`<div><b>${esc(f.t)}</b><span>${esc(f.d)}</span></div>`).join('')}</div><h4>Especificaciones</h4>${specs(p)}${p.t?`<div class="tg">${esc(p.t)}</div>`:''}<div class="pg">Página ${String(p.pg).padStart(2,'0')} del Catálogo Cerro Verde 2026 · Solo para uso veterinario</div></div>`;
  $('f-x').addEventListener('click',()=>dlg.close());
  if(typeof dlg.showModal==='function')dlg.showModal();else dlg.setAttribute('open','');
