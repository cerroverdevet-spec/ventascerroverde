<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="description" content="Cerro Verde, C.A.: insumos y equipos médicos veterinarios en Venezuela. Catálogo de 113 equipos de imagenología, laboratorio, odontología, quirófano, esterilización, oftalmología y hospitalización. Envíos nacionales.">
<meta property="og:title" content="Cerro Verde Veterinaria">
<meta property="og:description" content="Equipos médicos veterinarios en Venezuela. Catálogo completo y envíos nacionales.">

<style>:root{color-scheme:light;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}body{margin:0}img{max-width:100%}[hidden]{display:none!important}</style>
<title>Cerro Verde Veterinaria</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,500..900&family=Source+Sans+3:wght@400;500;600;700&display=swap">
<style>
/* Layout: banda verde de marca arriba (cerro + hero), cuerpo crema con catálogo filtrable, cierre verde con contacto */
:root{
  --forest:#445b41;      /* verde de marca: encabezado, bandas */
  --forest-deep:#34472f; /* tarjetas oscuras, botones */
  --sage:#aebd9f;        /* fichas de icono */
  --cream:#f6f2e8;       /* fondo principal */
  --sand:#ebe1d1;        /* paneles */
  --clay:#7a4e35;        /* acento marrón (rayas, etiquetas) */
  --ink:#27311f; --muted:#625d52; --line:#ddd2bf; --card:#fffdf8; --on-forest:#f3f1e8; --on-forest-muted:#c9d4bf;
  --display:'Archivo','Arial Narrow',Helvetica,sans-serif;
  --body:'Source Sans 3','Segoe UI',Helvetica,Arial,sans-serif;
  --r:10px;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --cream:#161c14;--sand:#1f281c;--card:#222c1f;--line:#34412f;--ink:#ecebe2;--muted:#b3b2a3;--sage:#4c5e45;--clay:#c8936f;
  --forest:#2c3b29;--forest-deep:#3d5238;--on-forest:#f3f1e8;--on-forest-muted:#b9c7ad;color-scheme:dark}}
:root[data-theme="dark"]{
  --cream:#161c14;--sand:#1f281c;--card:#222c1f;--line:#34412f;--ink:#ecebe2;--muted:#b3b2a3;--sage:#4c5e45;--clay:#c8936f;
  --forest:#2c3b29;--forest-deep:#3d5238;--on-forest:#f3f1e8;--on-forest-muted:#b9c7ad;color-scheme:dark}
*{box-sizing:border-box}
body{background:var(--cream);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.55;margin:0}
a{color:inherit}
:focus-visible{outline:3px solid var(--clay);outline-offset:3px;border-radius:4px}
.wrap{max-width:1180px;margin-inline:auto;padding-inline:clamp(16px,4vw,40px)}
h1,h2,h3{font-family:var(--display);font-stretch:112%;text-wrap:balance;margin:0;line-height:1.05;letter-spacing:-.01em}
.eyebrow{font-family:var(--body);font-weight:700;font-size:.78rem;letter-spacing:.16em;text-transform:uppercase;color:var(--clay);display:flex;align-items:center;gap:.7em}
.eyebrow::before{content:"";width:28px;height:4px;border-radius:3px;background:var(--clay)}
.btn{display:inline-flex;align-items:center;gap:.55em;font-weight:700;font-size:1rem;text-decoration:none;padding:.85em 1.3em;border-radius:999px;border:0;cursor:pointer;font-family:var(--body);transition:transform .15s ease}
.btn:hover{transform:translateY(-1px)}
.btn svg{width:1.15em;height:1.15em}
.btn-light{background:var(--on-forest);color:#2c3a29}
.btn-ghost{background:transparent;color:var(--on-forest);box-shadow:inset 0 0 0 2px rgba(243,241,232,.45)}
.btn-dark{background:var(--forest-deep);color:var(--on-forest)}

/* header */
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--forest);color:var(--on-forest)}
.top .wrap{display:flex;align-items:center;gap:24px;padding-block:10px}
.top img{height:58px;display:block}
.nav{display:flex;gap:22px;margin-left:auto;font-weight:600;font-size:.98rem}
.nav a{text-decoration:none;opacity:.9}
.nav a:hover{opacity:1;text-decoration:underline;text-underline-offset:5px}
.top .btn{padding:.6em 1.05em;font-size:.92rem}

/* hero */
.hero{background:var(--forest);color:var(--on-forest);position:relative;overflow:hidden}
.hero .wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:48px;align-items:center;padding-block:56px 110px}
.hero .eyebrow{color:var(--on-forest-muted)} .hero .eyebrow::before{background:var(--on-forest-muted)}
.hero h1{font-size:clamp(2.3rem,5.4vw,4.1rem);font-weight:850;margin-block:18px 18px}
.hero p.lead{font-size:1.15rem;color:var(--on-forest-muted);max-width:34em;margin:0 0 28px}
.hero .ctas{display:flex;flex-wrap:wrap;gap:12px}
.facts{display:flex;flex-wrap:wrap;gap:10px 26px;margin-top:34px;font-size:.92rem;color:var(--on-forest-muted)}
.facts b{color:var(--on-forest);font-weight:700}
.stage{position:relative;aspect-ratio:1/1;max-width:100%}
.stage .main{position:absolute;inset:6% 10% 14% 4%;border-radius:18px;overflow:hidden;background:#fff;box-shadow:0 30px 60px -25px rgba(0,0,0,.5)}
.stage .main img{width:100%;height:100%;object-fit:cover}
.stage .chip{position:absolute;background:#fff;border-radius:14px;padding:10px;box-shadow:0 18px 40px -18px rgba(0,0,0,.55);width:30%}
.stage .chip img{display:block;width:100%;aspect-ratio:1/1;object-fit:contain}
.stage .c1{right:0;top:0}.stage .c2{right:3%;bottom:2%;width:26%}
.stage .tag{position:absolute;left:0;bottom:4%;background:var(--forest-deep);color:var(--on-forest);border-radius:12px;padding:12px 16px;font-size:.88rem;line-height:1.35;box-shadow:0 18px 40px -18px rgba(0,0,0,.6)}
.stage .tag b{display:block;font-family:var(--display);font-stretch:110%;font-size:1.15rem}
.ridge{position:absolute;left:0;right:0;bottom:-1px;width:100%;height:90px;display:block}
.ridge path{fill:var(--cream)}

/* lines */
section{padding-block:72px}
.head{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:16px 40px;margin-bottom:34px}
.head h2{font-size:clamp(1.8rem,3.6vw,2.7rem);font-weight:800;margin-top:12px;color:var(--ink)}
.head p{margin:0;max-width:30em;color:var(--muted)}
.lines{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px}
.line{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:20px 20px 18px;display:flex;flex-direction:column;gap:10px;min-width:0}
.line .ic{width:46px;height:46px;border-radius:10px;background:var(--sage);display:grid;place-items:center;color:var(--forest-deep)}
:root[data-theme="dark"] .line .ic{color:var(--on-forest)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .line .ic{color:var(--on-forest)}}
.line .ic svg{width:24px;height:24px}
.line h3{font-size:1.18rem;font-weight:750;font-stretch:105%}
.line p{margin:0;font-size:.95rem;color:var(--muted)}

/* catalog */
.catalog{background:var(--sand)}
.filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:24px}
.filters button{font:600 .93rem var(--body);padding:.55em 1em;border-radius:999px;border:1.5px solid var(--line);background:var(--card);color:var(--ink);cursor:pointer}
.filters button[aria-pressed="true"]{background:var(--forest-deep);border-color:var(--forest-deep);color:var(--on-forest)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:16px}
.prod{background:var(--card);border-radius:var(--r);overflow:hidden;display:flex;flex-direction:column;border:1px solid var(--line);min-width:0}
.prod .ph{background:#fff;aspect-ratio:4/3;display:grid;place-items:center;padding:14px}
.prod .ph img{max-height:100%;max-width:100%;object-fit:contain}
.prod .bd{padding:14px 16px 16px;display:flex;flex-direction:column;gap:6px;flex:1}
.prod .cat{font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--clay)}
.prod h3{font-size:1.3rem;font-weight:800}
.prod .nm{font-size:.97rem;color:var(--ink);font-weight:600;line-height:1.3}
.prod .sp{font-size:.86rem;color:var(--muted);margin-top:auto;padding-top:6px;font-variant-numeric:tabular-nums}
.prod a{margin-top:10px;font-weight:700;font-size:.92rem;color:var(--forest-deep);text-decoration:none;display:inline-flex;gap:.4em;align-items:center}
:root[data-theme="dark"] .prod a{color:var(--sage)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .prod a{color:#b9c7ad}}
:root[data-theme="dark"] .prod a{color:#b9c7ad}
.prod a:hover{text-decoration:underline}
.more{margin-top:26px;color:var(--muted);font-size:.98rem}

/* why */
.why{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:28px}
.why div{border-top:3px solid var(--forest);padding-top:16px}
.why h3{font-size:1.15rem;font-weight:750;font-stretch:105%;margin-bottom:6px}
.why p{margin:0;color:var(--muted);font-size:.97rem}

/* contact */
.contact{background:var(--forest);color:var(--on-forest)}
.contact .wrap{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start}
.contact .eyebrow{color:var(--on-forest-muted)}.contact .eyebrow::before{background:var(--on-forest-muted)}
.contact h2{font-size:clamp(1.8rem,3.6vw,2.7rem);font-weight:800;margin-block:12px 14px}
.contact p{color:var(--on-forest-muted);margin:0 0 24px;max-width:30em}
.ways{display:flex;flex-direction:column;gap:10px}
.way{display:flex;align-items:center;gap:14px;background:rgba(255,255,255,.07);border-radius:12px;padding:12px 14px;min-width:0}
.way svg{width:22px;height:22px;flex:none}
.way .v{font-weight:700;font-size:1.05rem;user-select:all;overflow-wrap:anywhere}
.way .k{font-size:.8rem;color:var(--on-forest-muted)}
.way button{margin-left:auto;font:600 .82rem var(--body);background:transparent;border:1.5px solid rgba(243,241,232,.4);color:var(--on-forest);border-radius:999px;padding:.35em .9em;cursor:pointer;flex:none}
form{background:var(--cream);color:var(--ink);border-radius:16px;padding:24px;display:grid;gap:14px}
form h3{font-size:1.3rem;font-weight:800}
label{display:grid;gap:5px;font-weight:600;font-size:.9rem}
input,select,textarea{font:inherit;font-size:1rem;padding:.65em .8em;border-radius:8px;border:1.5px solid var(--line);background:var(--card);color:var(--ink);width:100%}
textarea{min-height:90px;resize:vertical}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
form .btn{justify-content:center}
form small{color:var(--muted);font-size:.84rem}

footer{background:var(--forest-deep);color:var(--on-forest-muted);font-size:.9rem}
footer .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px 30px;padding-block:22px}
footer b{color:var(--on-forest)}

@media (max-width:900px){
  .hero .wrap,.contact .wrap{grid-template-columns:1fr}
  .stage{max-width:460px}
  .nav{display:none}
  .top .btn{margin-left:auto}
}
@media (max-width:480px){ .top img{height:46px} .row2{grid-template-columns:1fr} .top .btn span{display:none} }
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
/* ---- añadidos v2: catálogo completo, ficha, nosotros, envíos ---- */
:root{--ok:#3f6b3a}
.hero .facts b{font-variant-numeric:tabular-nums}
.lines{grid-template-columns:repeat(auto-fit,minmax(250px,1fr))}
button.line{font:inherit;color:inherit;text-align:left;cursor:pointer;transition:border-color .15s ease,transform .15s ease}
button.line:hover{border-color:var(--forest);transform:translateY(-2px)}
.line .lt{display:flex;align-items:baseline;justify-content:space-between;gap:10px}
.line .lt b{font-family:var(--display);font-stretch:105%;font-size:1.18rem;font-weight:750}
.line .cnt{font-size:.85rem;color:var(--clay);font-weight:700;white-space:nowrap;font-variant-numeric:tabular-nums}
.line .ld{font-size:.95rem;color:var(--muted)}

.ship{background:var(--forest-deep);color:var(--on-forest)}
.ship .wrap{display:grid;grid-template-columns:auto 1fr auto;gap:22px;align-items:center;padding-block:26px}
.ship .tk{width:58px;height:58px;border-radius:14px;background:var(--on-forest);color:#2c3a29;display:grid;place-items:center}
.ship .tk svg{width:30px;height:30px}
.ship h2{font-size:clamp(1.35rem,2.6vw,1.8rem);font-weight:800}
.ship p{margin:4px 0 0;color:var(--on-forest-muted);max-width:44em}
section.ship{padding-block:0}

.tools{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-bottom:14px}
.search{flex:1 1 260px;position:relative;min-width:0}
.search svg{position:absolute;left:14px;top:50%;width:18px;height:18px;transform:translateY(-50%);color:var(--muted)}
.search input{padding-left:42px;border-radius:999px;background:var(--card)}
.count{font-size:.92rem;color:var(--muted);font-variant-numeric:tabular-nums}
.filters{margin-bottom:22px}
.prod{cursor:pointer;transition:border-color .15s ease,transform .15s ease}
.prod:hover{border-color:var(--forest);transform:translateY(-2px)}
.prod .ph{position:relative}
.prod .noimg{color:#9c8a73;font-size:.8rem;letter-spacing:.14em;text-transform:uppercase;text-align:center}
.prod .acts{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:10px}
.prod .acts a{margin-top:0}
.prod .open{font:700 .92rem var(--body);background:none;border:0;padding:0;color:var(--ink);cursor:pointer;text-decoration:underline;text-underline-offset:4px}
.empty{padding:40px 20px;text-align:center;color:var(--muted);background:var(--card);border:1px dashed var(--line);border-radius:var(--r)}
.empty[hidden]{display:none}

dialog{border:0;padding:0;border-radius:16px;width:min(920px,calc(100vw - 32px));max-height:calc(100dvh - 32px);background:var(--cream);color:var(--ink);box-shadow:0 40px 80px -30px rgba(0,0,0,.6)}
dialog::backdrop{background:rgba(20,28,18,.62)}
.fx{display:grid;grid-template-columns:300px minmax(0,1fr)}
.fx .side{background:var(--forest);color:var(--on-forest);padding:22px;display:flex;flex-direction:column;gap:14px}
.fx .pic{background:#fff;border-radius:12px;aspect-ratio:1/1;display:grid;place-items:center;padding:14px;max-width:100%}
.fx .pic img{max-height:100%;max-width:100%;object-fit:contain}
.fx .side .cat{font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--on-forest-muted)}
.fx .side h3{font-size:1.75rem;font-weight:850;color:var(--on-forest)}
.fx .side .sb{font-weight:600;color:var(--on-forest-muted);line-height:1.35}
.fx .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(80px,1fr));gap:8px}
.fx .st{background:rgba(255,255,255,.09);border-radius:10px;padding:9px 10px}
.fx .st b{display:block;font-family:var(--display);font-stretch:108%;font-size:1.12rem;line-height:1.1}
.fx .st span{font-size:.74rem;color:var(--on-forest-muted)}
.fx .side .btn{justify-content:center;margin-top:auto}
.fx .main{padding:22px 26px 26px;overflow:auto;min-width:0}
.fx .close{float:right;margin:0 0 10px 14px;font:700 .9rem var(--body);background:var(--sand);color:var(--ink);border:0;border-radius:999px;padding:.45em 1em;cursor:pointer}
.fx .desc{margin:0 0 4px;font-size:1.02rem}
.fx h4{font-family:var(--display);font-stretch:108%;font-size:1.05rem;font-weight:800;margin:22px 0 10px;display:flex;align-items:center;gap:10px;color:var(--ink)}
.fx h4::before{content:"";width:22px;height:4px;border-radius:3px;background:var(--clay)}
.feats{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px 18px}
.feats div b{display:block;font-size:.97rem}
.feats div span{font-size:.9rem;color:var(--muted)}
.kv{width:100%;border-collapse:separate;border-spacing:0 4px;font-size:.92rem}
.kv th{text-align:left;background:var(--sand);padding:.45em .8em;border-radius:6px 0 0 6px;width:38%;font-weight:700;vertical-align:top}
.kv td{background:var(--card);padding:.45em .8em;border-radius:0 6px 6px 0;font-variant-numeric:tabular-nums}
.tw{overflow-x:auto;margin-top:8px;border-radius:8px;border:1px solid var(--line)}
.mt{border-collapse:collapse;font-size:.88rem;min-width:100%;font-variant-numeric:tabular-nums}
.mt th{background:var(--forest);color:var(--on-forest);text-align:left;padding:.5em .7em;white-space:nowrap}
.mt td{padding:.45em .7em;border-top:1px solid var(--line);background:var(--card)}
.mt td:first-child{font-weight:700;white-space:nowrap}
.fx .tg{margin-top:16px;font-size:.85rem;color:var(--clay);font-weight:700}
.fx .pg{font-size:.82rem;color:var(--muted);margin-top:14px}

.about{display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:start}
.about .intro p{font-size:1.08rem;margin:0 0 14px;max-width:36em}
.about .intro h2{font-size:clamp(1.9rem,3.8vw,2.8rem);font-weight:850;margin:12px 0 18px}
.mision{background:var(--forest);color:var(--on-forest);border-radius:16px;padding:26px 26px 24px}
.mision .eyebrow{color:var(--on-forest-muted)}.mision .eyebrow::before{background:var(--on-forest-muted)}
.mision p{margin:12px 0 0;font-size:1.12rem;line-height:1.55}
.steps{list-style:none;margin:28px 0 0;padding:0;display:grid;gap:14px;counter-reset:s}
.steps li{display:grid;grid-template-columns:44px 1fr;gap:14px;align-items:start;counter-increment:s}
.steps li::before{content:counter(s);width:44px;height:44px;border-radius:50%;background:var(--sand);color:var(--forest-deep);font:800 1.15rem var(--display);display:grid;place-items:center}
:root[data-theme="dark"] .steps li::before{color:var(--on-forest)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .steps li::before{color:var(--on-forest)}}
.steps b{display:block;font-size:1.05rem}
.steps span{color:var(--muted);font-size:.96rem}
.why{margin-top:56px}

.cartbtn{position:relative}
.badge{min-width:1.45em;height:1.45em;border-radius:999px;background:var(--clay);color:#fff;font:700 .78rem/1.45em var(--body);text-align:center;padding:0 .35em;font-variant-numeric:tabular-nums}
.badge[hidden]{display:none}
.fab{position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));z-index:30;box-shadow:0 16px 34px -14px rgba(0,0,0,.6)}
.fab[hidden]{display:none}
.add{font:700 .9rem var(--body);background:var(--forest-deep);color:var(--on-forest);border:0;border-radius:999px;padding:.5em .95em;cursor:pointer;display:inline-flex;gap:.4em;align-items:center}
.add svg{width:1em;height:1em}
.add.in{background:var(--sage);color:var(--forest-deep)}
.prod .acts{flex-wrap:wrap}
.prod .acts .links{display:flex;gap:14px;align-items:center}
#carro{width:min(560px,calc(100vw - 32px))}
.cw{padding:22px 22px 24px;display:grid;gap:16px}
.cw .hd{display:flex;justify-content:space-between;align-items:center;gap:10px}
.cw h3{font-size:1.5rem;font-weight:850}
.cw .close{font:700 .9rem var(--body);background:var(--sand);color:var(--ink);border:0;border-radius:999px;padding:.45em 1em;cursor:pointer}
.items{display:grid;gap:8px;max-height:40vh;overflow:auto}
.it{display:grid;grid-template-columns:52px minmax(0,1fr) auto;gap:12px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:8px 10px}
.it .im{width:52px;height:52px;background:#fff;border-radius:8px;display:grid;place-items:center;overflow:hidden}
.it .im img{max-width:90%;max-height:90%;object-fit:contain}
.it b{display:block;font-size:.98rem;overflow-wrap:anywhere}
.it span{font-size:.84rem;color:var(--muted)}
.qty{display:flex;align-items:center;gap:4px}
.qty button{width:30px;height:30px;border-radius:50%;border:1.5px solid var(--line);background:var(--cream);color:var(--ink);font:700 1rem var(--body);cursor:pointer;line-height:1}
.qty output{min-width:1.8em;text-align:center;font-weight:700;font-variant-numeric:tabular-nums}
.rm{font:600 .8rem var(--body);background:none;border:0;color:var(--clay);cursor:pointer;padding:2px 0;text-decoration:underline}
.cempty{padding:26px 16px;text-align:center;color:var(--muted);background:var(--card);border:1px dashed var(--line);border-radius:10px}
.cw .note{font-size:.88rem;color:var(--muted);margin:0}
.cw .btn{justify-content:center}
